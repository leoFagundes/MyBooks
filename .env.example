# Copie para .env.local e preencha. Nunca coloque chaves secretas em variáveis NEXT_PUBLIC_.

# Endereço público do site (links absolutos e imagens de compartilhamento)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase: Project Settings → API Keys. A chave publicável pode ir para o navegador.
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Só no servidor (livros de fora no catálogo e as capas no bucket) e nos testes
# E2E (cria e apaga contas de teste). Nunca no cliente.
SUPABASE_SECRET_KEY=sb_secret_...

# Só para a CLI (migrations e tipos) e os testes de banco: Account → Access Tokens.
SUPABASE_ACCESS_TOKEN=

# Opcional, só no servidor: a busca usa o Google Books quando a Open Library
# falha ou não acha nada. Sem chave, a busca fica só com a Open Library (a cota
# anônima do Google é zero). Google Cloud → APIs → Books API → Credenciais.
GOOGLE_BOOKS_API_KEY=
