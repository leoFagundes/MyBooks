# Copie para .env.local e preencha. Nunca coloque chaves secretas em variáveis NEXT_PUBLIC_.

# Endereço público do site (links absolutos e imagens de compartilhamento)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase: Project Settings → API Keys. A chave publicável pode ir para o navegador.
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Só no servidor e nos testes E2E (cria e apaga contas de teste). Nunca no cliente.
SUPABASE_SECRET_KEY=sb_secret_...

# Só para a CLI (migrations e tipos) e os testes de banco: Account → Access Tokens.
SUPABASE_ACCESS_TOKEN=
