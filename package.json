{
  "name": "mybooks",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "prebuild": "node scripts/limpar-next.mjs && node scripts/gerar-creditos.mjs",
    "build": "next build",
    "postbuild": "node scripts/gerar-sw.mjs && node scripts/verificar-bundle.mjs",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit && tsc -p features/pwa/worker/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test --project=desktop --project=mobile",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:db": "vitest run --config vitest.db.config.mts",
    "supabase": "node --env-file-if-exists=.env.local node_modules/supabase/dist/supabase.js",
    "db:link": "node --env-file-if-exists=.env.local node_modules/supabase/dist/supabase.js link --project-ref djehboxlhvjtlrvmdiis",
    "db:push": "node --env-file-if-exists=.env.local node_modules/supabase/dist/supabase.js db push --linked",
    "db:seed": "node --env-file-if-exists=.env.local node_modules/supabase/dist/supabase.js db push --linked --include-seed",
    "db:types": "node --env-file-if-exists=.env.local node_modules/supabase/dist/supabase.js gen types typescript --project-id djehboxlhvjtlrvmdiis --schema public > lib/supabase/database.types.ts",
    "seed:gerar": "tsx scripts/gerar-seed.mts",
    "test:e2e:producao": "playwright test --project=producao",
    "test:auditoria": "playwright test --project=auditoria",
    "capas:copiar": "tsx --conditions=react-server --env-file=.env.local scripts/copiar-capas.mts",
    "pwa:icones": "tsx scripts/gerar-icones.tsx",
    "pwa:capturas": "tsx scripts/gerar-capturas.mts",
    "creditos": "node scripts/gerar-creditos.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@hookform/resolvers": "5.9.2",
    "@number-flow/react": "0.6.2",
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.2",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.118.0",
    "@tanstack/react-query": "5.105.0",
    "@tanstack/react-table": "9.3.1",
    "@vercel/analytics": "2.0.1",
    "@vercel/speed-insights": "2.0.0",
    "@zxing/browser": "0.2.1",
    "@zxing/library": "0.23.0",
    "class-variance-authority": "0.7.1",
    "cmdk": "1.1.1",
    "cn": "0.5.1",
    "fractional-indexing": "4.0.0",
    "lenis": "1.3.27",
    "lucide-react": "1.66.0",
    "motion": "14.9.0",
    "next": "16.4.3",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-easy-crop": "6.2.4",
    "react-hook-form": "7.91.0",
    "server-only": "0.0.1",
    "shadcn": "4.23.0",
    "sonner": "2.0.8",
    "three": "0.187.0",
    "tw-animate-css": "1.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@serwist/build": "9.5.13",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.187.0",
    "babel-plugin-react-compiler": "1.0.0",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "node-vibrant": "4.0.4",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "serwist": "9.5.13",
    "supabase": "2.122.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
